<Window x:Class="PuntersScraper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PuntersScraper.App"
        xmlns:vm="clr-namespace:PuntersScraper.App.ViewModels"
        mc:Ignorable="d"
        Title="Punters Meetings Scraper  ·  by VM" Height="700" Width="1080"
        MinHeight="540" MinWidth="880"
        Background="{StaticResource BgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="8" Height="28" CornerRadius="4" Background="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Punters Meetings Scraper" FontSize="19" FontWeight="Bold" />
                    <TextBlock Text="Horses · Greyhounds · Harness — meetings and full race detail" FontSize="11.5"
                               Foreground="{StaticResource SubtleTextBrush}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Developer branding badge -->
            <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="14" Padding="12,5"
                    Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                    ToolTip="Developed by VM">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}">
                        <Run Text="Developed by " />
                        <Run Text="VM" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Update banner: hidden unless MainViewModel finds a newer GitHub release on startup -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="10"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,14"
                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding UpdateStatusText}" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="{Binding UpdateButtonText}" Width="150" Style="{StaticResource PrimaryButton}"
                        Command="{Binding UpdateNowCommand}"
                        ToolTip="Downloads the new installer and runs it — this app closes automatically so the installer can update its files." />
            </Grid>
        </Border>

        <!-- Controls card -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="16,14" Margin="0,0,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                    <TextBlock Text="Date" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding SelectedDate}" Width="130" Margin="0,0,24,0"
                                CalendarStyle="{StaticResource DarkCalendarStyle}" />

                    <CheckBox Content="Horses (T)" IsChecked="{Binding ScrapeHorses}" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <CheckBox Content="Greyhounds (G)" IsChecked="{Binding ScrapeGreyhounds}" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <CheckBox Content="Harness (H)" IsChecked="{Binding ScrapeHarness}" Margin="0,0,24,0" VerticalAlignment="Center" />

                    <CheckBox Content="Headless" IsChecked="{Binding Headless}" VerticalAlignment="Center"
                              ToolTip="Unchecked (default) runs a real browser positioned off-screen, so it never appears yet still passes Punters' bot-detection reliably. Checking this uses true headless mode instead, which is faster but may get blocked." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                    <TextBlock Text="Country (ISO2)" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,8,0" />
                    <TextBox Text="{Binding CountryCodeFilter, UpdateSourceTrigger=PropertyChanged}" Width="64" Margin="0,0,24,0"
                             ToolTip="Optional. Only scrape meetings in this country, e.g. AU, NZ, US, GB. Leave blank for all countries." />

                    <TextBlock Text="Course name" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,8,0" />
                    <TextBox Text="{Binding CourseNameFilter, UpdateSourceTrigger=PropertyChanged}" Width="170" Margin="0,0,24,0"
                             ToolTip="Optional. Only scrape meetings whose course/meeting name contains this text, e.g. Belmont. Leave blank for all courses." />

                    <Button Content="Scrape" Width="110" Style="{StaticResource PrimaryButton}" Command="{Binding ScrapeCommand}" Margin="0,0,10,0"
                            ToolTip="Scrapes meetings AND every race's full runner/jockey/form detail for the selected discipline(s), date, and filters — one click, everything." />
                    <Button Content="Export JSON..." Width="140" Style="{StaticResource SecondaryButton}" Command="{Binding ExportJsonCommand}"
                            ToolTip="Saves one folder per meeting, each containing that meeting's file plus a DataDump file for every scraped race." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Download folder" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,8,0" />
                    <TextBox Text="{Binding DownloadFolder}" Width="340" IsReadOnly="True" Margin="0,0,8,0"
                             ToolTip="Default folder Export JSON opens to, and that auto-export (if enabled) writes to directly." />
                    <Button Content="Browse..." Width="90" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseDownloadFolderCommand}" Margin="0,0,24,0" />

                    <CheckBox Content="Auto-export JSON after scrape" IsChecked="{Binding AutoExportAfterScrape}" VerticalAlignment="Center" Margin="0,0,24,0"
                              ToolTip="When checked, a successful scrape immediately saves JSON to the download folder above — no prompt. Requires a download folder to be set." />

                    <CheckBox Content="Also upload to S3 (pending)" IsChecked="{Binding UploadToS3}" VerticalAlignment="Center" Margin="0,0,10,0"
                              ToolTip="When checked, every exported file is also uploaded directly into the configured bucket's pending folder — flat, no per-meeting nesting there (local files keep their per-meeting folders as usual)." />

                    <TextBlock Text="Bucket" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,8,0" />
                    <TextBox Text="{Binding S3BucketName, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,24,0"
                             ToolTip="S3 bucket name to upload to. Remembered across app restarts." />

                    <TextBlock Text="Access Key" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,8,0" />
                    <TextBox Text="{Binding S3AccessKey, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,24,0"
                             ToolTip="S3 access key. Remembered across app restarts (stored locally, never in source control)." />

                    <TextBlock Text="Secret Key" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,8,0" />
                    <TextBox Text="{Binding S3SecretKey, UpdateSourceTrigger=PropertyChanged}" Width="140"
                             ToolTip="S3 secret key. Remembered across app restarts (stored locally, never in source control)." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Margin="0,0,0,14" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Meetings}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                      BorderThickness="0" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Discipline" Binding="{Binding Discipline}" Width="80" />
                    <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="110" />
                    <DataGridTextColumn Header="Meeting" Binding="{Binding MeetingName}" Width="*" />
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="60" />
                    <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="70" />
                    <DataGridTextColumn Header="Races" Binding="{Binding RaceCount}" Width="55" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding RacesWithDetail}" Width="55" />
                    <DataGridTextColumn Header="First Race" Binding="{Binding FirstRaceLocalTime}" Width="90" />
                    <DataGridTextColumn Header="Track" Binding="{Binding TrackCondition}" Width="80" />
                    <DataGridTextColumn Header="Stage" Binding="{Binding MeetingStage}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource SubtleTextBrush}" />
            <ProgressBar Grid.Column="1" Width="180" IsIndeterminate="{Binding IsBusy}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Window>
