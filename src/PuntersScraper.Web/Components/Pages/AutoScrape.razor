@page "/auto-scrape"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject PuntersScraper.Web.Services.ScrapeSessionService Session
@implements IDisposable

<PageTitle>Punters Meetings Scraper — Auto Scraper</PageTitle>

<div class="panel">
    <h2 style="font-size:15px;">Auto Scraper</h2>
    <div style="display:flex; gap:24px; flex-wrap:wrap; align-items:flex-end; margin-bottom:14px;">
        <label style="flex-direction:row; align-items:center; gap:6px;">
            <input type="checkbox" checked="@Settings.AutoScrapeEnabled" @onchange="OnAutoScrapeEnabledChanged" /> Enabled
        </label>
        <label style="flex-direction:row; align-items:center; gap:6px;">
            <input type="checkbox" checked="@Settings.AutoScrapeIncludeYesterday" @onchange="OnAutoScrapeIncludeYesterdayChanged" /> Yesterday
        </label>
        <label style="flex-direction:row; align-items:center; gap:6px;">
            <input type="checkbox" checked="@Settings.AutoScrapeIncludeToday" @onchange="OnAutoScrapeIncludeTodayChanged" /> Today
        </label>
        <label style="flex-direction:row; align-items:center; gap:6px;">
            <input type="checkbox" checked="@Settings.AutoScrapeIncludeTomorrow" @onchange="OnAutoScrapeIncludeTomorrowChanged" /> Tomorrow
        </label>
    </div>

    <div style="display:flex; gap:24px; flex-wrap:wrap; align-items:flex-end; margin-bottom:14px;">
        <label style="flex-direction:row; align-items:center; gap:6px;">
            <input type="checkbox" checked="@Settings.AutoScrapeHorses" @onchange="OnAutoScrapeHorsesChanged" /> Horses (T)
        </label>
        <label style="flex-direction:row; align-items:center; gap:6px;">
            <input type="checkbox" checked="@Settings.AutoScrapeGreyhounds" @onchange="OnAutoScrapeGreyhoundsChanged" /> Greyhounds (G)
        </label>
        <label style="flex-direction:row; align-items:center; gap:6px;">
            <input type="checkbox" checked="@Settings.AutoScrapeHarness" @onchange="OnAutoScrapeHarnessChanged" /> Harness (H)
        </label>
    </div>

    <div style="display:flex; gap:24px; flex-wrap:wrap; align-items:flex-end;">
        <label>
            Times of day (24h)
            <input type="text" value="@Settings.AutoScrapeTimesOfDay" @onchange="OnAutoScrapeTimesOfDayChanged" placeholder="e.g. 06:00,18:00" style="width:220px;" />
        </label>
    </div>
    <p style="font-size:11.5px;color:var(--subtle);margin-top:4px;">
        Comma-separated — add as many times as you want (e.g. "06:00,18:00" for twice a day).
    </p>

    <p style="font-size:12px;color:var(--subtle);margin-top:8px;max-width:640px;">
        When enabled, this server scrapes automatically at each listed time (server-local time), for the
        selected day(s)/discipline(s) above, across every country and course — independent of the manual
        controls on the <a href="/">Scraper</a> page. Results land in the same table on the Scraper page
        as a manual scrape would.
        @if (Settings.AutoScrapeLastRunUtc is not null)
        {
            <text><br />Last completed run: @Settings.AutoScrapeLastRunUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") — @Settings.AutoScrapeLastRunSummary</text>
        }
    </p>
</div>

<div class="panel">
    <h2 style="font-size:15px;">Live progress</h2>
    <p style="font-size:12px;color:var(--subtle);margin-top:0;margin-bottom:10px;">
        This updates the moment either an auto-scrape run or a manual scrape (from the
        <a href="/">Scraper</a> page) is in progress — it's the same underlying run, just viewable
        from here too.
    </p>
    <table>
        <thead>
            <tr>
                <th>Date</th><th>Discipline</th><th>Group</th><th>Meeting</th><th>State</th><th>Country</th>
                <th>Races</th><th>Detail</th><th>First Race</th><th>Track</th><th>Stage</th><th style="width:130px;">Progress</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Session.Meetings.ToList())
            {
                <tr>
                    <td>@row.Date.ToString("yyyy-MM-dd")</td>
                    <td>@row.Discipline</td>
                    <td>@row.Group</td>
                    <td>@row.MeetingName</td>
                    <td>@row.State</td>
                    <td>@row.Country</td>
                    <td>@row.RaceCount</td>
                    <td>@row.RacesWithDetail</td>
                    <td>@row.FirstRaceLocalTime</td>
                    <td>@row.TrackCondition</td>
                    <td>@row.MeetingStage</td>
                    <td>
                        <div class="progress-track" title="@row.ProgressPercent%">
                            <div class="progress-fill" style="width:@(row.ProgressPercent)%;"></div>
                        </div>
                        <span class="progress-label">@row.ProgressPercent%</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="status-bar">
    <span>@Session.StatusText</span>
    <button type="button" class="secondary" @onclick="Session.RequestStop" disabled="@(!Session.IsBusy || Session.IsStopping)">
        @(Session.IsStopping ? "Stopping..." : "Stop")
    </button>
    <button type="button" class="secondary" @onclick="Session.ClearResults" disabled="@Session.IsBusy">Clear</button>
    @if (Session.IsBusy)
    {
        <span class="spinner"></span>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }

    private PuntersScraper.Web.Services.WebAppSettings Settings = PuntersScraper.Web.Services.WebAppSettings.Load();

    private void OnAutoScrapeEnabledChanged(ChangeEventArgs e)
    {
        Settings.AutoScrapeEnabled = e.Value is bool b && b;
        Settings.Save();
    }

    private void OnAutoScrapeIncludeYesterdayChanged(ChangeEventArgs e)
    {
        Settings.AutoScrapeIncludeYesterday = e.Value is bool b && b;
        Settings.Save();
    }

    private void OnAutoScrapeIncludeTodayChanged(ChangeEventArgs e)
    {
        Settings.AutoScrapeIncludeToday = e.Value is bool b && b;
        Settings.Save();
    }

    private void OnAutoScrapeIncludeTomorrowChanged(ChangeEventArgs e)
    {
        Settings.AutoScrapeIncludeTomorrow = e.Value is bool b && b;
        Settings.Save();
    }

    private void OnAutoScrapeHorsesChanged(ChangeEventArgs e)
    {
        Settings.AutoScrapeHorses = e.Value is bool b && b;
        Settings.Save();
    }

    private void OnAutoScrapeGreyhoundsChanged(ChangeEventArgs e)
    {
        Settings.AutoScrapeGreyhounds = e.Value is bool b && b;
        Settings.Save();
    }

    private void OnAutoScrapeHarnessChanged(ChangeEventArgs e)
    {
        Settings.AutoScrapeHarness = e.Value is bool b && b;
        Settings.Save();
    }

    private void OnAutoScrapeTimesOfDayChanged(ChangeEventArgs e)
    {
        Settings.AutoScrapeTimesOfDay = e.Value?.ToString() ?? Settings.AutoScrapeTimesOfDay;
        Settings.Save();
    }
}
